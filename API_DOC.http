#===================Accounts======================

#api call for creating admin
###
POST  http://127.0.0.1:8000/owner/register/
Content-Type: application/json

{
    "username":"admin",
    "email":"admin@gmail.com",
    "password":"admin@123"
}


#api call for creating user or player
###
POST  http://127.0.0.1:8000/player/register/
Content-Type: application/json

{
    "username":"player",
    "email":"player@gmail.com",
    "password":"player@123"
}

#===================Turf===========================

# api call for list turf 
###
GET http://127.0.0.1:8000/turf/
Accept: application/json
Authorization: Basic admin:admin@123

#create turf deatial
###
POST http://127.0.0.1:8000/turf/
Content-Type: application/json
Authorization: Basic admin:admin@123

{
    "name":"legends_area",
    "location":"tpr",
    "address":"legends,tpr",
    "description":"....",
    "opening_time":"07:00",
    "closing_time":"02:00",
    "day_price":600,
    "night_price":900,
    "facilities":"parking,rest room"
}

# turf retrive data
###
GET http://127.0.0.1:8000/turf/1/
Accept: application/json
Authorization: Basic admin:admin@123

# update
###
PUT  http://127.0.0.1:8000/turf/1/
Content-Type: application/json
Authorization: Basic admin:admin@123

{
    "name":"game",
    "location":"cgfd",
    "address":"game,hf",
    "description":"df...",
    "opening_time":"09:00",
    "closing_time":"01:00",
    "day_price":550,
    "night_price":900,
    "facilities":"parking,rest room"
}


#delete
###
DELETE http://127.0.0.1:8000/turf/1/
Accept: application/json
Authorization: Basic admin:admin@123


#==========================Booking================
#api call for booking
###
POST  http://127.0.0.1:8000/booking/
Content-Type: application/json
Authorization: Basic player:player@123

{
    "name":"vishu",
    "phone":"56454551",
    "email":"vishnu@gmail.com",
    "turf":2,
    "match_date":"2026-11-29",
    "duration":2,
    "start_time":"8:00"

}

#api call for retrieve 
###
GET  http://127.0.0.1:8000/booking/1/
Accept: application/json

#api call for updating
###
PUT  http://127.0.0.1:8000/booking/1/
Content-Type: application/json

{
    "id": "1",
    "name": "afsal",
    "phone": "67981354",
    "email": "afsal@gmail.com",
    "turf": "1",
    "match_date": "2026-12-29",
    "duration": 2,
    "start_time": "09:00:00"
}


#api call for details
###
POST  http://127.0.0.1:8000/booking/summary/
Content-Type: application/json

{
    
